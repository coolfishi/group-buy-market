# 商城服务配置：复制为 mall.env（权限 600），填写后执行 sudo docker compose up -d mall
# 这些密钥只保存在服务器上，不要提交到仓库

# 对外访问地址：支付宝回调、支付完成后跳转都用它
PUBLIC_BASE_URL=https://shop.openrelayx.cc

# 登录令牌签名密钥，至少 32 位随机字符：openssl rand -hex 32
SESSION_SECRET=

# 管理台账号，密码至少 12 位
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------- 支付宝（开放平台 → 沙箱应用） ----------
PAY_PROVIDER=alipay
ALIPAY_APP_ID=
# 应用私钥与支付宝公钥：整段写在一行，可以带或不带 -----BEGIN ...----- 头尾，换行用 \n
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# 私钥格式，留空时自动判断（无头尾的私钥默认按 PKCS8）
ALIPAY_KEY_TYPE=
# 沙箱网关；正式环境改为 https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
PAY_TIMEOUT_MINUTES=30
# 异步通知地址，需要是 80/443 端口（沙箱对其他端口的通知不可靠）
ALIPAY_NOTIFY_URL=https://shop.openrelayx.cc/api/v1/alipay/alipay_notify_url

# ---------- 微信公众号（可用“接口测试号”） ----------
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 与公众号后台“服务器配置”里填写的 Token 一致
WECHAT_TOKEN=

# 进行中的可参团队伍少于这个数时，自动用演示用户补充已付款的拼团（0 表示关闭）
DEMO_TEAMS_MIN=5

# 拼团渠道，与拼团活动配置一致
GBM_SOURCE=s01
GBM_CHANNEL=c01
