# 复制为 .env.live.local 后按实际环境填写，再执行 npm run dev:live / npm run build:live
VITE_APP_MODE=live

# 拼团服务与支付商城的 API 地址。经 Nginx 同源代理时填 "/"；也可填完整地址，如 https://api.example.com
VITE_GBM_API_BASE=/
VITE_MALL_API_BASE=/

# 渠道与来源，需与后端拼团活动配置一致
VITE_SOURCE=s01
VITE_CHANNEL=c01

# 演示商品 ID -> 后端真实潮玩 SKU。只填写已在后端配置好的潮玩商品；未填写的商品在真实模式下不可购买
# 例：VITE_LIVE_SKU_MAP={"TS-1001":"1000001","TS-2001":"1000002"}
VITE_LIVE_SKU_MAP={}

# 允许提交支付表单的地址（逗号分隔的 origin）
VITE_PAY_ALLOWED_ORIGINS=https://openapi.alipay.com,https://openapi-sandbox.dl.alipaydev.com

# 请求超时（毫秒）
VITE_REQUEST_TIMEOUT_MS=10000

# 仅本地开发使用：vite 代理目标（不带 VITE_ 前缀，不会打包进前端）
# GBM_PROXY_TARGET=http://localhost:8091
# MALL_PROXY_TARGET=http://localhost:8092
